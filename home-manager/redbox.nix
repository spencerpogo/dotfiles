{ config
, lib
, pkgs
, ...
}:
let
  inherit (import ./modules/i3/workspaces.nix) ws0 ws1;
in
{
  # My desktop PC, running NixOS

  imports = [
    ./configs/desktop.nix

    ./modules/rust.nix
    ./modules/fcitx5.nix
    ./modules/i3/i3.nix
    ./modules/gtk.nix
    ./modules/udiskie.nix
    ./modules/xdg.nix
  ];

  nixpkgs.config.permittedInsecurePackages = [ "electron-13.6.9" ];
  nixpkgs.overlays = [
    (self: super: {
      discord = (
        super.discord.override {
          withOpenASAR = true;
          withVencord = true;
          vencord = "${config.home.homeDirectory}/github/vencord/dist";
        }
      );
    })
  ];
  programs.command-not-found.enable = true;

  xsession.windowManager.i3 = {
    config.startup = [
      {
        # Monitor layout generated by arandr for this machine.
        command = "xrandr --output DisplayPort-0 --off --output DisplayPort-1 --off --output DisplayPort-2 --off --output HDMI-A-0 --primary --mode 1920x1080 --pos 1440x0 --rotate normal --output DVI-D-0 --mode 1440x900 --pos 0x180 --rotate normal";
      }
    ];
    extraConfig = ''
      workspace ${ws0} output DVI-D-0
      workspace ${ws1} output HDMI-A-0
    '';
  };

  home.packages = with pkgs; [
    # more unzip
    p7zip
    # reverse engineering
    ghidra-bin
    # VMs
    virt-manager
    # flashcards
    anki-bin
    # nix code formatting
    alejandra
    # ebooks
    calibre
    # notes
    obsidian
    # nix searching
    nix-index
    # wrapping sqlite
    rlwrap
    # sqlite
    sqlite
    # image viewer (used by i3 anyway)
    feh
    # youtube downloader
    yt-dlp
    # media processing
    ffmpeg
  ];
}
